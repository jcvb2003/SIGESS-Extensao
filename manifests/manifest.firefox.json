{
  "manifest_version": 2,
  "name": "SIGESS",
  "version": "3.1.9",
  "description": "Automatiza logins e preenchimento de formulários em sites governamentais",
  "permissions": [
    "contextualIdentities",
    "cookies",
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "browsingData",
    "alarms",
    "clipboardWrite",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "https://pesqbrasil-pescadorprofissional.agro.gov.br/*",
    "https://pesqbrasil-pescadorprofissional.mpa.gov.br/*",
    "https://sso.acesso.gov.br/*",
    "https://login.esocial.gov.br/*",
    "https://www.esocial.gov.br/*",
    "https://*.cadunico.dataprev.gov.br/*",
    "https://*.tse.jus.br/*",
    "https://*.receita.fazenda.gov.br/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "assets/background.js"
    ]
  },
  "web_accessible_resources": [
    "assets/content_script.js",
    "assets/content_reap.js",
    "assets/content_reap_turbo.js",
    "assets/content_esocial.js",
    "assets/pesqbrasil_bridge.js",
    "assets/reap_page_bridge.js",
    "assets/caepf_bridge.js",
    "assets/cadunico_bridge.js",
    "assets/tse_bridge.js",
    "assets/inss_bridge.js",
    "data_inspector.html",
    "assets/data_inspector.js",
    "sidebar.html",
    "sigess-logo.png"
  ],
  "icons": {
    "16": "sigess-logo.png",
    "32": "sigess-logo.png",
    "48": "sigess-logo.png",
    "128": "sigess-logo.png"
  },
  "browser_action": {
    "default_title": "SIGESS",
    "default_icon": {
      "16": "sigess-logo.png",
      "32": "sigess-logo.png",
      "48": "sigess-logo.png"
    },
    "default_popup": "popup.html"
  },
  "sidebar_action": {
    "default_title": "SIGESS - Acompanhamento de Lote",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "sigess-logo.png",
      "32": "sigess-logo.png",
      "48": "sigess-logo.png"
    }
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Alt+S",
        "mac": "Command+Alt+S"
      },
      "description": "Abrir ou fechar o painel lateral do SIGESS"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "assets/content_script.js"
      ]
    },
    {
      "matches": [
        "*://pesqbrasil-pescadorprofissional.agro.gov.br/*",
        "*://pesqbrasil-pescadorprofissional.mpa.gov.br/*"
      ],
      "js": [
        "assets/content_reap.js",
        "assets/content_reap_turbo.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.esocial.gov.br/portal/Home/Inicial*",
        "https://www.esocial.gov.br/portal/FolhaPagamento/Listagem/Competencias*",
        "https://www.esocial.gov.br/portal/FolhaPagamento/Listagem/ListarPagamentos*",
        "https://www.esocial.gov.br/portal/FolhaPagamento/FechamentoFolha*"
      ],
      "js": [
        "assets/content_esocial.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://pesqbrasil-pescadorprofissional.agro.gov.br/*",
        "*://pesqbrasil-pescadorprofissional.mpa.gov.br/*",
        "*://*.esocial.gov.br/*",
        "*://*.gov.br/*",
        "*://*.receita.fazenda.gov.br/*",
        "*://*.tse.jus.br/*",
        "https://app.sigess.com.br/registration*",
        "https://sigess-extensao.vercel.app/registration*",
        "http://localhost:5173/registration*"
      ],
      "js": [
        "assets/content_auto_registration.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://pesqbrasil-pescadorprofissional.agro.gov.br/*",
        "*://pesqbrasil-pescadorprofissional.mpa.gov.br/*",
        "*://*.esocial.gov.br/*",
        "*://*.gov.br/*",
        "*://*.receita.fazenda.gov.br/*",
        "*://*.tse.jus.br/*",
        "https://app.sigess.com.br/registration*",
        "https://sigess-extensao.vercel.app/registration*",
        "http://localhost:5173/registration*"
      ],
      "js": [
        "assets/capture_indicator.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://servicos.mte.gov.br/*"
      ],
      "js": [
        "assets/content_sdpa.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    "sigess-logo.png"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{e9df396f-bdd8-4e79-bc7c-92017a928891}",
      "update_url": "https://downloads.sigess.com.br/updates.json"
    }
  }
}
