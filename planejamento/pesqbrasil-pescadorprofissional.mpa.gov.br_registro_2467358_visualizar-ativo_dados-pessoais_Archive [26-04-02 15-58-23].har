itacao\":null,\"aprovacaoAutomatica\":true}},{\"id\":2,\"nome\":\"Recadastramento\",\"camposAdicionais\":{\"sancao\":false,\"idAgrupadorSolicitacao\":null,\"aprovacaoAutomatica\":true}},{\"id\":4,\"nome\":\"REAP\",\"camposAdicionais\":{\"sancao\":false,\"idAgrupadorSolicitacao\":null,\"aprovacaoAutomatica\":true}},{\"id\":11,\"nome\":\"Ativação em Lote\",\"camposAdicionais\":{\"sancao\":false,\"idAgrupadorSolicitacao\":null,\"aprovacaoAutomatica\":true}},{\"id\":12,\"nome\":\"Cancelamento em Lote\",\"camposAdicionais\":{\"sancao\":false,\"idAgrupadorSolicitacao\":null,\"aprovacaoAutomatica\":true}},{\"id\":13,\"nome\":\"Suspensão em Lote\",\"camposAdicionais\":{\"sancao\":false,\"idAgrupadorSolicitacao\":null,\"aprovacaoAutomatica\":true}}],\"SituacaoAnaliseSolicitacao\":[{\"id\":1,\"nome\":\"Aguardando Análise\",\"camposAdicionais\":{}},{\"id\":2,\"nome\":\"Em Análise\",\"camposAdicionais\":{}},{\"id\":3,\"nome\":\"Deferida\",\"camposAdicionais\":{}},{\"id\":4,\"nome\":\"Indeferida\",\"camposAdicionais\":{}},{\"id\":5,\"nome\":\"Finalizada\",\"camposAdicionais\":{}}],\"TipoAmbientePesca\":[{\"id\":1,\"nome\":\"Água Doce\",\"camposAdicionais\":{}},{\"id\":2,\"nome\":\"Água Salgada\",\"camposAdicionais\":{}}],\"TipoJustificativaAnaliseDocumento\":[{\"id\":1,\"nome\":\"Nome do(a) pescador(a) ou nome do pai ou mãe divergente\",\"camposAdicionais\":{\"observacao\":\"O nome informado no cadastro (Pescador, mãe ou pai) é diferente do documento de identificação anexado. Solicitamos que acesse o site da Receita Federal para realizar a atualização dos dados: https://servicos.receita.fazenda.gov.br/servicos/cpf/alterar/default.asp.\",\"tipoDocumentoPessoal\":{\"id\":1,\"nome\":\"Identificação\",\"descricao\":null}}},{\"id\":2,\"nome\":\"Dados de RG divergentes\",\"camposAdicionais\":{\"observacao\":\"Divergência entre os dados informados no formulário eletrônico e o documento de identificação oficial apresentado em anexo (RG, CNH, ETC). Por favor, corrigir as informações do formulário eletrônico (em caso de RG divergente) ou no cadastro na Receita Federal (para demais informações) Endereço: https://servicos.receita.fazenda.gov.br/servicos/cpf/alterar/default.asp.\",\"tipoDocumentoPessoal\":{\"id\":1,\"nome\":\"Identificação\",\"descricao\":null}}},{\"id\":3,\"nome\":\"Data de nascimento divergente\",\"camposAdicionais\":{\"observacao\":\"Divergência entre a data de nascimento informada no formulário eletrônico e o documento de identificação oficial apresentado em anexo (RG, CNH, ETC). Por favor, corrigir a informação no formulário eletrônico.\",\"tipoDocumentoPessoal\":{\"id\":1,\"nome\":\"Identificação\",\"descricao\":null}}},{\"id\":4,\"nome\":\"Data de expedição do documento divergente\",\"camposAdicionais\":{\"observacao\":\"Divergência entre a data de expedição do documento informada no formulário eletrônico e o documento de identificação oficial apresentado em anexo (RG, CNH, ETC). Por favor, corrigir a informação no formulário eletrônico.\",\"tipoDocumentoPessoal\":{\"id\":1,\"nome\":\"Identificação\",\"descricao\":null}}},{\"id\":5,\"nome\":\"Documento de identidade ilegível/ausente/apenas frente ou verso\",\"camposAdicionais\":{\"observacao\":\"Documento de identificação ilegível, ausente ou incompleto. Por favor, apresentar documento de identificação oficial com foto, legível.\",\"tipoDocumentoPessoal\":{\"id\":1,\"nome\":\"Identificação\",\"descricao\":null}}},{\"id\":6,\"nome\":\"Nome do(a) pescador(a) ou nome do pai ou mãe divergente\",\"camposAdicionais\":{\"observacao\":\"O nome informado no cadastro (Pescador, mãe ou pai) diverge do documento anexado. Solicitamos que acesse o site da Receita Federal para realizar a atualização dos dados: https://servicos.receita.fazenda.gov.br/servicos/cpf/alterar/default.asp.\",\"tipoDocumentoPessoal\":{\"id\":16,\"nome\":\"Passaporte\",\"descricao\":null}}},{\"id\":7,\"nome\":\"Dados divergentes\",\"camposAdicionais\":{\"observacao\":\"Divergência entre os dados informados no formulário eletrônico e o documento de identificação oficial apresentado em anexo (Passaporte). Por favor, corrigir as informações do formulário eletrônico ou no cadastro na Receita Federal (em caso de informações vindas da Receita Federal) Endereço: https://servicos.receita.fazenda.gov.br/servicos/cpf/alterar/default.asp.\",\"tipoDocumentoPessoal\":{\"id\":16,\"nome\":\"Passaporte\",\"descricao\":null}}},{\"id\":8,\"nome\":\"Documento com validade expirada\",\"camposAdicionais\":{\"observacao\":\"A validade do documento anexado está expirada. Por favor, enviar um documento válido.\",\"tipoDocumentoPessoal\":{\"id\":16,\"nome\":\"Passaporte\",\"descricao\":null}}},{\"id\":9,\"nome\":\"Documento ilegível/incompleto\",\"camposAdicionais\":{\"observacao\":\"Documento de identificação ilegível ou incompleto. Por favor, apresentar documento completo e legível.\",\"tipoDocumentoPessoal\":{\"id\":16,\"nome\":\"Passaporte\",\"descricao\":null}}},{\"id\":10,\"nome\":\"Visto não disponibilizado\",\"camposAdicionais\":{\"observacao\":\"Documento ausente. Por favor, apresentar documento completo e legível.\",\"tipoDocumentoPessoal\":{\"id\":16,\"nome\":\"Passaporte\",\"descricao\":null}}},{\"id\":11,\"nome\":\"Data de expedição do documento divergente\",\"camposAdicionais\":{\"observacao\":\"Divergência dos dados de data de expedição entre o documento de identificação oficial apresentado em anexo (passaporte ou outros) e a informação apresentada no formulário eletrônico. Por favor, corrigir a informação no formulário eletrônico.\",\"tipoDocumentoPessoal\":{\"id\":16,\"nome\":\"Passaporte\",\"descricao\":null}}},{\"id\":12,\"nome\":\"Data divergente\",\"camposAdicionais\":{\"observacao\":\"Divergência entre a data informada no formulário e o documento em anexo. Por favor, corrigir a data informada no formulário eletrônico ou incluir documento compatível com a informação preenchida no formulário.\",\"tipoDocumentoPessoal\":{\"id\":7,\"nome\":\"Visto de Trabalho\",\"descricao\":null}}},{\"id\":13,\"nome\":\"Documento com validade expirada\",\"camposAdicionais\":{\"observacao\":\"A validade do documento anexado está expirada. Por favor, anexar documento válido.\",\"tipoDocumentoPessoal\":{\"id\":7,\"nome\":\"Visto de Trabalho\",\"descricao\":null}}},{\"id\":14,\"nome\":\"Dados do documento divergentes\",\"camposAdicionais\":{\"observacao\":\"Divergência entre os dados informados no formulário eletrônico e o documento apresentado em anexo. Por favor, corrigir as informações do formulário eletrônico.\",\"tipoDocumentoPessoal\":{\"id\":7,\"nome\":\"Visto de Trabalho\",\"descricao\":null}}},{\"id\":15,\"nome\":\"Documento ilegível/ausente/apenas frente ou verso\",\"camposAdicionais\":{\"observacao\":\"Documento ilegível, ausente ou incompleto. Por favor, apresentar documento legível.\",\"tipoDocumentoPessoal\":{\"id\":7,\"nome\":\"Visto de Trabalho\",\"descricao\":null}}},{\"id\":16,\"nome\":\"Nome no comprovante divergente do formulário\",\"camposAdicionais\":{\"observacao\":\"Divergência do nome do(a) pescador(a) inserido no cadastro e o indicado no comprovante/declaração de residência anexados. Acessar o sítio eletrônico da Receita Federal para atualizar ou alterar os seus dados de endereço utilizando o link a seguir: https://servicos.receita.fazenda.gov.br/servicos/cpf/alterar/default.asp ou apresentar novo comprovante/declaração de residência.\",\"tipoDocumentoPessoal\":{\"id\":2,\"nome\":\"Comprovante de endereço\",\"descricao\":null}}},{\"id\":17,\"nome\":\"Comprovante não está no nome do interessado(a)\",\"camposAdicionais\":{\"observacao\":\"Comprovante/declaração de residência não está em nome do(a) pescador(a). Apresentar novo comprovante/declaração em nome do pescador (a).\",\"tipoDocumentoPessoal\":{\"id\":2,\"nome\":\"Comprovante de endereço\",\"descricao\":null}}},{\"id\":18,\"nome\":\"Comprovante ou declaração de residência ilegível/ausente\",\"camposAdicionais\":{\"observacao\":\"Documento ilegível, ausente ou incompleto. Por favor, apresentar documento legível e válido.\",\"tipoDocumentoPessoal\":{\"id\":2,\"nome\":\"Comprovante de endereço\",\"descricao\":null}}},{\"id\":19,\"nome\":\"Declaração de residência não assinada\",\"camposAdicionais\":{\"observacao\":\"Declaração de Residência não assinada. Por favor, apresentar Declaração de Residência assinada pelo pescador(a) e em caso de pecador (a) não alfabetizado incluir assinatura das testemunhas.\",\"tipoDocumentoPessoal\":{\"id\":2,\"nome\":\"Comprovante de endereço\",\"descricao\":null}}},{\"id\":20,\"nome\":\"Declaração de residência fora do padrão\",\"camposAdicionais\":{\"observacao\":\"Declaração de Residência fora do padrão estabelecido na Portaria MPA nº 127, de 29 de agosto de 2023. Por favor, apresentar declaração no padrão estabelecido pela normativa.\",\"tipoDocumentoPessoal\":{\"id\":2,\"nome\":\"Comprovante de endereço\",\"descricao\":null}}},{\"id\":21,\"nome\":\"Dados de residência divergentes do formulário\",\"camposAdicionais\":{\"observacao\":\"Divergência dos dados de residência inseridos no cadastro e os indicados no comprovante/declaração de residência anexados. Acessar o sítio eletrônico da Receita Federal para atualizar ou alterar os seus dados de endereço utilizando o link a seguir: https://servicos.receita.fazenda.gov.br/servicos/cpf/alterar/default.asp ou apresentar novo comprovante/declaração de residência.\",\"tipoDocumentoPessoal\":{\"id\":2,\"nome\":\"Comprovante de endereço\",\"descricao\":null}}},{\"id\":22,\"nome\":\"Foto 3x4 inserida fora do formato/com borda\",\"camposAdicionais\":{\"observacao\":\"Foto 3x4 fora com bordas grandes. Por favor, anexar foto no enquadramento correto sem bordas.\",\"tipoDocumentoPessoal\":{\"id\":3,\"nome\":\"Foto 3X4\",\"descricao\":null}}},{\"id\":23,\"nome\":\"Foto 3x4 inserida desconfigurada\",\"camposAdicionais\":{\"observacao\":\"A foto 3x4 anexada está desconfigurada. Por favor, anexar foto no enquadramento correto.\",\"tipoDocumentoPessoal\":{\"id\":3,\"nome\":\"Foto 3X4\",\"descricao\":null}}},{\"id\":24,\"nome\":\"Foto 3x4 inserida em preto e branco\",\"camposAdicionais\":{\"observacao\":\"A foto 3x4 anexada está em preto e branco. Por favor, anexar foto colorida.\",\"tipoDocumentoPessoal\":{\"id\":3,\"nome\":\"Foto 3X4\",\"descricao\":null}}},{\"id\":25,\"nome\":\"Foto 3x4 inserida desatualizada\",\"camposAdicionais\":{\"observacao\":\"A foto 3x4 anexada está desatualizada. Por favor, anexar foto atual.\",\"tipoDocumentoPessoal\":{\"id\":3,\"nome\":\"Foto 3X4\",\"descricao\":null}}},{\"id\":26,\"nome\":\"Foto 3x4 inserida com baixa qualidade\",\"camposAdicionais\":{\"observacao\":\"A foto 3x4 enviada está com baixa resolução/qualidade. Por favor, apresentar foto com maior resolução/qualidade.\",\"tipoDocumentoPessoal\":{\"id\":3,\"nome\":\"Foto 3X4\",\"descricao\":null}}},{\"id\":27,\"nome\":\"Foto 3x4 fora do padrão estabelecido ou com adereço(s) não permitido(s)\",\"camposAdicionais\":{\"observacao\":\"O (a) pescador(a) está utilizando adereços não permitidos em foto 3x4 (boné, óculos escuro, entre outros). Por favor, apresentar foto 3x4 sem adereços.\",\"tipoDocumentoPessoal\":{\"id\":3,\"nome\":\"Foto 3X4\",\"descricao\":null}}},{\"id\":28,\"nome\":\"Dados do PIS/PASEP/NIT ou NIS divergente\",\"camposAdicionais\":{\"observacao\":\"Divergência de informação entre o número PIS/PASEP/NIT ou NIS inserido no cadastro e o indicado no comprovante. Por favor, alterar os dados no formulário ou anexar um comprovante compatível e válido.\",\"tipoDocumentoPessoal\":{\"id\":4,\"nome\":\"PIS/PASEP/NIT/NIS\",\"descricao\":null}}},{\"id\":29,\"nome\":\"PIS/PASEP/NIT ou NIS inconsistente ou com dados insuficientes\",\"camposAdicionais\":{\"observacao\":\"Documento PIS/PASEP/NIT ou NIS incompleto ou inconsistente. Por favor, corrigir os dados no formulário ou anexar um comprovante compatível e válido.\",\"tipoDocumentoPessoal\":{\"id\":4,\"nome\":\"PIS/PASEP/NIT/NIS\",\"descricao\":null}}},{\"id\":30,\"nome\":\"Comprovante PIS/PASEP/NIT ou NIS ilegível/ausente\",\"camposAdicionais\":{\"observacao\":\"Documento ilegível, ausente ou incompleto. Por favor, apresentar documento legível.\",\"tipoDocumentoPessoal\":{\"id\":4,\"nome\":\"PIS/PASEP/NIT/NIS\",\"descricao\":null}}},{\"id\":31,\"nome\":\"Documento enviado não é válido\",\"camposAdicionais\":{\"observacao\":\"Apresentação de documento de PIS/PASEP/NIT/NIS inválido. Por favor, apresentar documento oficial/válido.\",\"tipoDocumentoPessoal\":{\"id\":4,\"nome\":\"PIS/PASEP/NIT/NIS\",\"descricao\":null}}},{\"id\":32,\"nome\":\"Protocolo sem assinatura/carimbo\",\"camposAdicionais\":{\"observacao\":\"Protocolo apresentado sem assinatura ou carimbo. Solicite segunda via do documento na Superintendência Federal da Pesca e Aquicultura em seu estado.\",\"tipoDocumentoPessoal\":{\"id\":9,\"nome\":\"Comprovante de Protocolo\",\"descricao\":null}}},{\"id\":33,\"nome\":\"Protocolo ilegível/ausente\",\"camposAdicionais\":{\"observacao\":\"Documento ilegível, ausente ou incompleto. Por favor, apresentar documento legível/válido.\",\"tipoDocumentoPessoal\":{\"id\":9,\"nome\":\"Comprovante de Protocolo\",\"descricao\":null}}},{\"id\":34,\"nome\":\"Protocolo inválido\",\"camposAdicionais\":{\"observacao\":\"Protocolo apresentado está fora do padrão estabelecido. Solicite segunda via do documento na Superintendência Federal da Pesca e Aquicultura em seu estado.\",\"tipoDocumentoPessoal\":{\"id\":9,\"nome\":\"Comprovante de Protocolo\",\"descricao\":null}}},{\"id\":35,\"nome\":\"Data divergente do formulário\",\"camposAdicionais\":{\"observacao\":\"Protocolo com data divergente da apresentada no formulário. Por favor, alterar a data informada no formulário eletrônico.\",\"tipoDocumentoPessoal\":{\"id\":9,\"nome\":\"Comprovante de Protocolo\",\"descricao\":null}}},{\"id\":36,\"nome\":\"Nome do pescador não consta na listagem\",\"camposAdicionais\":{\"observacao\":\"O nome do(a) pescador(a) não consta na listagem do ofício/protocolo em anexo. Encaminhe o ofício/protocolo completo ou, caso seja necessário, solicite segunda via do documento na Superintendência Federal da Pesca e Aquicultura em seu estado.\",\"tipoDocumentoPessoal\":{\"id\":9,\"nome\":\"Comprovante de Protocolo\",\"descricao\":null}}},{\"id\":37,\"nome\":\"Declaração de filiação ilegível/ausente\",\"camposAdicionais\":{\"observacao\":\"Documento ilegível, ausente ou incompleto. Por favor, apresentar documento legível/válido.\",\"tipoDocumentoPessoal\":{\"id\":8,\"nome\":\"Comprovante de Filiação à Entidade\",\"descricao\":null}}},{\"id\":38,\"nome\":\"Declaração de filiação não assinada\",\"camposAdicionais\":{\"observacao\":\"Declaração de filiação sem assinatura. Por favor, apresentar declaração assinada pelo pescador e pelo presidente da entidade e em caso de pecador (a) não alfabetizado incluir assinatura das testemunhas.\",\"tipoDocumentoPessoal\":{\"id\":8,\"nome\":\"Comprovante de Filiação à Entidade\",\"descricao\":null}}},{\"id\":39,\"nome\":\"Declaração de filiação fora do modelo padrão\",\"camposAdicionais\":{\"observacao\":\"Declaração de filiação fora do modelo padrão estabelecido na Portaria MPA nº 127, de 29 de agosto de 2023. Por favor, apresentar declaração no padrão estabelecido pela normativa.\",\"tipoDocumentoPessoal\":{\"id\":8,\"nome\":\"Comprovante de Filiação à Entidade\",\"descricao\":null}}},{\"id\":40,\"nome\":\"Caderneta inválida\",\"camposAdicionais\":{\"observacao\":\"Documento inválido. Por favor, apresentar Caderneta de Inscrição e Registro válida.\",\"tipoDocumentoPessoal\":{\"id\":18,\"nome\":\"CIR\",\"descricao\":null}}},{\"id\":41,\"nome\":\"Documento com validade expirada\",\"camposAdicionais\":{\"observacao\":\"A validade do documento anexado está expirada. Por favor, envie um documento válido ou altere as informações preenchidas no formulário.\",\"tipoDocumentoPessoal\":{\"id\":18,\"nome\":\"CIR\",\"descricao\":null}}},{\"id\":42,\"nome\":\"Dados do documento divergentes\",\"camposAdicionais\":{\"observacao\":\"Divergência entre os dados informados no formulário eletrônico e o documento apresentado em anexo. Por favor, corrigir as informações do formulário eletrônico ou anexar um novo documento.\",\"tipoDocumentoPessoal\":{\"id\":18,\"nome\":\"CIR\",\"descricao\":null}}},{\"id\":43,\"nome\":\"Documento ilegível/ inválido/apenas frente ou verso\",\"camposAdicionais\":{\"observacao\":\"Documento ilegível, inválido ou incompleto. Por favor, apresentar documento legível, válido e completo.\",\"tipoDocumentoPessoal\":{\"id\":18,\"nome\":\"CIR\",\"descricao\":null}}},{\"id\":44,\"nome\":\"Data divergente/desatualizada\",\"camposAdicionais\":{\"observacao\":\"Divergência entre os dados informados no formulário eletrônico e o documento apresentado em anexo. Por favor, corrigir as informações do formulário eletrônico ou anexar um novo documento.\",\"tipoDocumentoPessoal\":{\"id\":17,\"nome\":\"CTPS\",\"descricao\":null}}},{\"id\":45,\"nome\":\"Documento com validade expirada\",\"camposAdicionais\":{\"observacao\":\"A validade do documento anexado está expirada. Solicitamos que envie um documento válido ou altere as informações preenchidas no formulário. Por favor, anexar documento em validade.\",\"tipoDocumentoPessoal\":{\"id\":17,\"nome\":\"CTPS\",\"descricao\":null}}},{\"id\":46,\"nome\":\"Dados do documento divergentes\",\"camposAdicionais\":{\"observacao\":\"Divergência entre os dados informados no formulário eletrônico e o documento apresentado em anexo. Por favor, corrigir as informações do formulário eletrônico.\",\"tipoDocumentoPessoal\":{\"id\":17,\"nome\":\"CTPS\",\"descricao\":null}}},{\"id\":47,\"nome\":\"Documento ilegível/ inválido/apenas frente ou verso\",\"camposAdicionais\":{\"observacao\":\"Documento ilegível, inválido ou incompleto. Por favor, apresentar documento legível, válido e completo.\",\"tipoDocumentoPessoal\":{\"id\":17,\"nome\":\"CTPS\",\"descricao\":null}}},{\"id\":48,\"nome\":\"Outros\",\"camposAdicionais\":{\"observacao\":null,\"tipoDocumentoPessoal\":null}},{\"id\":49,\"nome\":\"Dados do comprovante divergentes do formulário\",\"camposAdicionais\":{\"observacao\":\"Os dados do documento apresentado divergem dos informados no formulário eletrônico. Altere os dados no formulário eletrônico ou apresente um documento com as informações correspondentes ao formulário de solicitação.\",\"tipoDocumentoPessoal\":{\"id\":14,\"nome\":\"Comprovante de primeiro RGP\",\"descricao\":null}}},{\"id\":50,\"nome\":\"Documento sem assinatura/carimbo\",\"camposAdicionais\":{\"observacao\":\"Documento apresentado sem assinatura ou carimbo. Solicite segunda via do documento na Superintendância Federal da Pesca e Aquicultura em seu estado.\",\"tipoDocumentoPessoal\":{\"id\":14,\"nome\":\"Comprovante de primeiro RGP\",\"descricao\":null}}},{\"id\":51,\"nome\":\"Documento ilegível/apenas frente ou verso\",\"camposAdicionais\":{\"observacao\":\"Documento ilegível ou incompleto. Por favor, apresentar documento legível/completo.\",\"tipoDocumentoPessoal\":{\"id\":14,\"nome\":\"Comprovante de primeiro RGP\",\"descricao\":null}}},{\"id\":52,\"nome\":\"Nome do pescador não consta na listagem\",\"camposAdicionais\":{\"observacao\":\"O nome do(a) pescador(a) não consta na listagem do ofício/protocolo em anexo. Encaminhe o ofício/protocolo completo ou, caso seja necessário, solicite segunda via do documento na Superintendância Federal da Pesca e Aquicultura em seu estado.\",\"tipoDocumentoPessoal\":{\"id\":14,\"nome\":\"Comprovante de primeiro RGP\",\"descricao\":null}}},{\"id\":53,\"nome\":\"Documento inválido\",\"camposAdicionais\":{\"observacao\":\"Documento apresentado está fora do padrão estabelecido e não é válido como comprovante de data e/ou órgão de 1° RGP. Solicite segunda via do documento na Superintendância Federal da Pesca e Aquicultura em seu estado.\",\"tipoDocumentoPessoal\":{\"id\":14,\"nome\":\"Comprovante de primeiro RGP\",\"descricao\":null}}},{\"id\":54,\"nome\":\"Licença suspensa/cancelada\",\"camposAdicionais\":{\"observacao\":\"Documento refere-se a um RGP suspenso/cancelado.\",\"tipoDocumentoPessoal\":{\"id\":14,\"nome\":\"Comprovante de primeiro RGP\",\"descricao\":null}}},{\"id\":55,\"nome\":\"Requerimento não está de acordo com o modelo\",\"camposAdicionais\":{\"observacao\":\"O requerimento de cancelamento não está conforme o modelo padrão do Ministério da Pesca e Aquicultura. Apresente um novo requerimento assinado, disponível para download no botão (modelo de requerimento), localizado na tela de solicitação de cancelamento do sistema.\",\"tipoDocumentoPessoal\":{\"id\":19,\"nome\":\"Requerimento de Cancelamento\",\"descricao\":null}}},{\"id\":56,\"nome\":\"Requerimento não assinado pelo(a) interessado(a)\",\"camposAdicionais\":{\"observacao\":\"Requerimento de cancelamento sem assinatura. Apresentar requerimento assinado pelo(a) interessado(a) e em caso de pescador(a) não alfabetizado incluir assinatura das testemunhas.\",\"tipoDocumentoPessoal\":{\"id\":19,\"nome\":\"Requerimento de Cancelamento\",\"descricao\":null}}},{\"id\":57,\"nome\":\"Documento ilegível\",\"camposAdicionais\":{\"observacao\":\"Documento ilegível ou incompleto. Por favor, apresentar documento legível/válido.\",\"tipoDocumentoPessoal\":{\"id\":19,\"nome\":\"Requerimento de Cancelamento\",\"descricao\":null}}},{\"id\":58,\"nome\":\"Dados divergentes\",\"camposAdicionais\":{\"observacao\":\"Divergência de informação entre os dados inseridos no cadastro e o requerimento de cancelamento. Por favor, alterar os dados no formulário ou anexar um requerimento com informações compatíveis.\",\"tipoDocumentoPessoal\":{\"id\":19,\"nome\":\"Requerimento de Cancelamento\",\"descricao\":null}}},{\"id\":59,\"nome\":\"Inserir Descricao\",\"camposAdicionais\":{\"observacao\":\"Dados da Migracao nao mapeados na origem\",\"tipoDocumentoPessoal\":null}}],\"TipoUf\":[{\"id\":2,\"nome\":\"ACRE\",\"camposAdicionais\":{\"sigla\":\"AC\",\"siglaRegiao\":\"N\",\"codigoIbge\":\"12\",\"codigoRf\":\"0022\"}},{\"id\":14,\"nome\":\"ALAGOAS\",\"camposAdiciona