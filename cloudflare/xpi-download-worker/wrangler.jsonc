{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sigess-extension-download",
  "main": "src/index.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["GITHUB_READ_TOKEN"],
  },
  "routes": [
    {
      "pattern": "downloads.sigess.com.br",
      "custom_domain": true,
    },
  ],
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
